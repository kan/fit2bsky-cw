{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fit2bsky-cw",
	"main": "src/index.ts",
	// 上げるときは npm test と wrangler deploy --dry-run で挙動の差を確かめる
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true,
	// 入口は Custom Domain だけにする。Access はホスト名ごとに掛かり、アプリ側は認証を
	// 持たないので、workers.dev やプレビュー URL を開けておくとそこが素通しになりうる。
	// **Access アプリの Destinations にホスト名を足してからデプロイする**（逆順だと
	// デプロイ直後は誰でも開ける）
	"routes": [{ "pattern": "weight.fushihara.net", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	// Workers Logs。cron の実行と console.log / console.error も記録される
	"observability": {
		"enabled": true,
	},
	// Anthropic の API が使えないときに、コメントを DeepSeek で作る（src/ai.ts）。
	// AI は wrangler dev でも本物を呼ぶ（料金がかかる）。テストは vitest.config.mts で remote を切っている
	"ai": { "binding": "AI", "remote": true },
	"kv_namespaces": [
		{
			"binding": "FIT2BSKY_KV",
			"id": "6b63fe49f27f429da0e7836a07fc73e3",
			"preview_id": "63bfdea453d0471ca546f84865d574e8",
		},
	],
	"vars": {
		"TARGET_WEIGHT": "120.0",
		// BMI の計算に使う身長（cm）。Google Health API には BMI のデータ型が無い
		"HEIGHT_CM": "186.5",
	},
	// deploy の時点で、これらが設定されているかを検査する。wrangler types の Env にも入る
	"secrets": {
		"required": [
			"GOOGLE_HEALTH_CLIENT_ID",
			"GOOGLE_HEALTH_CLIENT_SECRET",
			"BSKY_HANDLE",
			"BSKY_PASSWORD",
			"SHEET_ID",
			"SHEET_NAME",
			"GOOGLE_CREDENTIALS",
			"ANTHROPIC_API_KEY",
		],
	},
	"triggers": {
		"crons": ["0 0 * * *", "0 3 * * *", "0 12 * * *"],
	},
}
