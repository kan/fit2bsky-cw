{
  "name": "fit2bsky-cw",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "cf-typegen": "wrangler types --strict-vars=false",
    "typecheck": "npm run cf-typegen -- --check && tsc --noEmit && tsc --noEmit -p test",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@msw/cloudflare": "^0.2.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "msw": "^3.0.7",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@atproto/api": "^0.32.5",
    "hono": "^4.13.19",
    "jose": "^6.2.18"
  }
}
